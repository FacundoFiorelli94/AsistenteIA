# GROQ_API_KEY: Required for Groq AI API calls (free tier available).
# Get your key at: https://console.groq.com/keys
# Supports models: llama-3.3-70b-versatile, llama3-70b-8192, mixtral-8x7b-32768, llama3-8b-8192
GROQ_API_KEY="your_groq_api_key_here"

# GEMINI_API_KEY: Optional - legacy Gemini support (not used by default).
# GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"
